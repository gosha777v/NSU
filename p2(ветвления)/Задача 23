p = int(input()) - 1

if p < 10:
    print(p)
elif p < 190:
    p = p - 10
    number = 10 + p // 2

    if p % 2 == 0:
        print(number // 10)
    else:
        print(number % 10)
else:
    p = p - 190
    number = 100 + p // 3

    if p % 3 == 0:
        print(number // 100)
    elif p % 3 == 1:
        print(number // 10 % 10)
    else:
        print(number % 10)
