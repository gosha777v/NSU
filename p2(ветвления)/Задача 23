p = int(input())   
if p == 1:
    print(0)
else:
    q = p - 1                       
    if q <= 9:                      
        print(q)
    elif q <= 189:                 
        r = q - 9
        number = 10 + (r - 1) // 2
        if (r - 1) % 2 == 0:
            print(number // 10)     
        else:
            print(number % 10)      
    else:                           
        r = q - 189
        number = 100 + (r - 1) // 3
        position = (r - 1) % 3
        if position == 0:
            print(number // 100)
        elif position == 1:
            print(number // 10 % 10)
        else:
            print(number % 10)