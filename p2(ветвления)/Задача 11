import turtle

xc = int(input()) 
yc = int(input()) 
r = int(input()) 
x = int(input()) 
y = int(input()) 

t = turtle.Turtle()  
t.up() 
t.goto(xc,yc - r) 
t.down() 
t.circle(r)
t.up()
t.goto(x,y) 
t.down()
t.dot(5,'red')

d = t.distance(xc, yc) 
if d < r:
    print('Точка внутри окружности')
elif d > r:
    print('Точка вне окружности')
else:
    print('Точка на окружности')    
           
t.hideturtle()
turtle.done()